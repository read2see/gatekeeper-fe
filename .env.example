# nuxt-auth-utils — required in production (auto-generated in dev if missing)
# Must be at least 32 characters. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Gatekeeper backend — server-only (never exposed to the browser)
NUXT_GATEKEEPER_API_BASE=http://localhost:8080

# Gatekeeper backend — used for avatar image URLs in the browser
NUXT_PUBLIC_GATEKEEPER_API_BASE=http://localhost:8080
